IMAGE_TAG=local
# 线上使用 ghcr.io/<owner>/contentflow；本地构建可保留 contentflow
CONTENTFLOW_IMAGE_PREFIX=contentflow
CN_POSTGRES_PASSWORD=replace_with_a_long_random_cn_database_password
INT_POSTGRES_PASSWORD=replace_with_a_different_long_random_int_database_password
CN_REDIS_PASSWORD=replace_with_a_long_random_cn_redis_password
INT_REDIS_PASSWORD=replace_with_a_different_long_random_int_redis_password
CN_JWT_SECRET=replace_with_at_least_32_random_cn_characters
CN_JWT_REFRESH_SECRET=replace_with_a_different_32_character_cn_secret
INT_JWT_SECRET=replace_with_at_least_32_random_int_characters
INT_JWT_REFRESH_SECRET=replace_with_a_different_32_character_int_secret
CN_CORS_ORIGIN=https://app.example.com
INT_CORS_ORIGIN=https://global.example.com
CN_WEB_PORT=3100
INT_WEB_PORT=3200
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_BACKUP=
OPENROUTER_MODELS=x-ai/grok-4.5
OPENROUTER_SITE_URL=https://app.example.com
AI_REQUEST_TIMEOUT_MS=60000
FAL_API_KEY=
FAL_API_KEY_BACKUP=
ENABLE_API_DOCS=false

API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ─── AI 能力（2026-08-18 新增端点所需）───
# 全部为服务端变量，**不要**加 NEXT_PUBLIC_ 前缀 —— 加了会打包进客户端，等于公开密钥。
# 未配置时对应端点返回 501 + PROVIDER_NOT_CONFIGURED，不会返回假数据。

# /api/ai/tts/openai、/api/ai/subtitle/generate（Whisper）
OPENAI_API_KEY=

# /api/ai/generate-script
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# /api/ai/tts/azure（两个都要，缺一不可）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# /api/ai/tts/elevenlabs
ELEVENLABS_API_KEY=

# /api/ai/generate-video、/api/video/generate
FAL_API_KEY=

# 注：/api/ai/merge-videos 与 /api/video/generate 的拼接阶段依赖系统 ffmpeg，
# 已在 Dockerfile 中安装；本地开发需自行 `brew install ffmpeg` 或 `apt install ffmpeg`。

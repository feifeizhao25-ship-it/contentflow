API_INTERNAL_URL=http://api:4000
# 错误上报：只接受境内自建 Sentry 的 https 地址；sentry.io 会被拒绝（数据出境）
SENTRY_DSN=
# 构建时上传 source map：同样只传境内自建 Sentry
SENTRY_URL=


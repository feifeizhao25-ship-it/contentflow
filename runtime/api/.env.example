NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://contentflow:replace_me@postgres:5432/contentflow
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://app.example.com,https://global.example.com
QWEN_API_KEY=
DEEPSEEK_API_KEY=
# 本地界面联调文本桩。仅当 NODE_ENV 不是 production 且值为 1 时生效，不会请求模型供应商。生产环境忽略。
# AI_LOCAL_STUB=
# AI 生成内容隐式标识里的服务提供者编码（如统一社会信用代码），未配置时为空
AIGC_PROVIDER_CODE=
FAL_API_KEY=
PAYMENT_CALLBACK_SECRET=replace_with_a_different_32_character_secret
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=https://api.example.cn/api/v1/billing/callbacks/alipay
ALIPAY_RETURN_URL=https://app.example.cn/payment/result
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# 手机号 + 短信验证码登录。SMS_PROVIDER 留空 = 短信服务未配置；aliyun 需要下面五项；
# dev 是固定验证码 123456 的开发实现，仅限本机开发，生产环境禁止（启动会失败）。
SMS_PROVIDER=
SMS_CODE_HMAC_SECRET=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 发布前要求手机号验证 + 实名认证（实名认证服务尚未接入）
REAL_NAME_REQUIRED_FOR_PUBLISH=false
# Business Webhook 订阅密钥的 AES-256-GCM 密钥。64 位十六进制（32 字节）。
# 留空则无法创建 Webhook（不会把签名密钥明文落库）。生成：openssl rand -hex 32
# 不得复用 JWT、支付回调或短信密钥。生产值只放密钥管理，不要写进仓库。
WEBHOOK_ENCRYPTION_KEY=
# 热点榜单。留空则接口说明尚未接入，不返回编造话题。
HOT_PROVIDER_URL=
HOT_PROVIDER_KEY=
HOT_PROVIDER_NAME=
# 合规资料最长引用天数。默认 30。过期进入保守模式，不停止生成。
RAG_MAX_AGE_DAYS=30
